---
// Giscus 评论组件 - 基于 GitHub Discussions
---

<div class="giscus mt-8 pt-8 border-t border-gray-200">
  <h3 class="text-lg font-semibold mb-4">评论</h3>
  <script src="https://giscus.app/client.js"
    data-repo="ProcessMonitor/wincy-blog"
    data-repo-id="R_kgDOSifYGg"
    data-category="Announcements"
    data-category-id="DIC_kwDOSifYGs4C9g5y"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</div>

<script is:inline>
  (function() {
    var getTheme = function() {
      var saved = localStorage.getItem('theme');
      if (saved === 'dark') return 'dark';
      if (saved === 'light') return 'light';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    var sendTheme = function(iframe) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: getTheme() } } },
        'https://giscus.app'
      );
    };

    // MutationObserver: 在 iframe.giscus-frame 挂载时立即发送主题
    var observer = new MutationObserver(function() {
      var iframe = document.querySelector('iframe.giscus-frame');
      if (iframe) {
        observer.disconnect();
        sendTheme(iframe);
      }
    });
    observer.observe(document.body, { childList: true, subtree: true });

    // 运行时主题切换
    window.addEventListener('theme-change', function() {
      var iframe = document.querySelector('iframe.giscus-frame');
      if (iframe) sendTheme(iframe);
    });
  })();
</script>

<style>
  .giscus {
    min-height: 200px;
  }
  :global(html.dark) .giscus {
    border-top-color: #3f3f46;
  }
</style>