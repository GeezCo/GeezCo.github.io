---
// Giscus 评论组件 - 基于 GitHub Discussions
// 配置参数需在 giscus.app 获取
// 支持深色模式同步
---

<div class="giscus mt-8 pt-8 border-t border-gray-200">
  <h3 class="text-lg font-semibold mb-4">评论</h3>
  <script src="https://giscus.app/client.js"
    data-repo="ProcessMonitor/wincy-blog"
    data-repo-id="R_kgDOSifYGg"
    data-category="Announcements"
    data-category-id="DIC_kwDOSifYGs4C9g5y"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="light"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async>
  </script>
</div>

<script>
  // Giscus 深色模式同步
  const getTheme = () => {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') return 'dark';
    if (saved === 'light') return 'light';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const syncGiscusTheme = (theme: string) => {
    const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
    if (!iframe) return;
    iframe.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
  };

  // 监听 iframe 加载完成
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://giscus.app') return;
    if (event.data?.giscus?.discussion) {
      // iframe 加载完成，同步当前主题
      syncGiscusTheme(getTheme());
    }
  });

  // 监听主题切换消息（来自 ThemeToggle）
  window.addEventListener('theme-change', ((event: CustomEvent) => {
    syncGiscusTheme(event.detail.theme);
  }) as EventListener);
</script>

<style>
  .giscus {
    min-height: 200px;
  }
  :global(html.dark) .giscus {
    border-t-color: #3f3f46;
  }
</style>