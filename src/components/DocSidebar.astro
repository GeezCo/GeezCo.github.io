---
interface NavItem {
  title: string;
  slug: string;
  order: number;
  children?: NavItem[];
}

interface Props {
  system: string;
  currentSlug: string;
  navTree: NavItem[];
}

const { system, currentSlug, navTree } = Astro.props;

function isActive(slug: string, current: string): boolean {
  return slug === current;
}

function hasActiveChild(item: NavItem, current: string): boolean {
  if (isActive(item.slug, current)) return true;
  if (item.children) {
    return item.children.some(child => hasActiveChild(child, current));
  }
  return false;
}
---

<aside class="doc-sidebar">
  <nav class="sidebar-nav">
    <ul class="nav-list">
      {navTree.map((item) => (
        <li class="nav-item">
          <a
            href={`/doc/${system}/${item.slug}`}
            class:list={[
              "nav-link",
              { active: isActive(item.slug, currentSlug) }
            ]}
          >
            {item.title}
          </a>
          {item.children && item.children.length > 0 && (
            <ul class="nav-sublist">
              {item.children.map((child) => (
                <li class="nav-subitem">
                  <a
                    href={`/doc/${system}/${child.slug}`}
                    class:list={[
                      "nav-sublink",
                      { active: isActive(child.slug, currentSlug) }
                    ]}
                  >
                    {child.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .doc-sidebar {
    width: 280px;
    height: 100vh;
    position: sticky;
    top: 0;
    overflow-y: auto;
    border-right: 1px solid #e5e7eb;
    background: #fafafa;
    padding: 2rem 0;
  }
  :global(html.dark) .doc-sidebar {
    background: #18181b;
    border-right-color: #27272a;
  }

  .sidebar-nav {
    padding: 0 1.5rem;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: 0.5rem;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    color: #52525b;
    text-decoration: none;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  .nav-link:hover {
    background: #f4f4f5;
    color: #18181b;
  }
  .nav-link.active {
    background: #3b82f6;
    color: white;
  }
  :global(html.dark) .nav-link {
    color: #a1a1aa;
  }
  :global(html.dark) .nav-link:hover {
    background: #27272a;
    color: #fafafa;
  }
  :global(html.dark) .nav-link.active {
    background: #60a5fa;
    color: white;
  }

  .nav-sublist {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0 0;
  }

  .nav-subitem {
    margin-bottom: 0.25rem;
  }

  .nav-sublink {
    display: block;
    padding: 0.375rem 0.75rem 0.375rem 2rem;
    color: #71717a;
    text-decoration: none;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    transition: all 0.2s;
  }
  .nav-sublink:hover {
    background: #f4f4f5;
    color: #18181b;
  }
  .nav-sublink.active {
    background: #eef2ff;
    color: #3b82f6;
    font-weight: 500;
  }
  :global(html.dark) .nav-sublink {
    color: #71717a;
  }
  :global(html.dark) .nav-sublink:hover {
    background: #27272a;
    color: #fafafa;
  }
  :global(html.dark) .nav-sublink.active {
    background: rgba(129, 140, 248, 0.1);
    color: #60a5fa;
  }

  /* 滚动条样式 */
  .doc-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .doc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .doc-sidebar::-webkit-scrollbar-thumb {
    background: #d4d4d8;
    border-radius: 3px;
  }
  .doc-sidebar::-webkit-scrollbar-thumb:hover {
    background: #a1a1aa;
  }
  :global(html.dark) .doc-sidebar::-webkit-scrollbar-thumb {
    background: #3f3f46;
  }
  :global(html.dark) .doc-sidebar::-webkit-scrollbar-thumb:hover {
    background: #52525b;
  }

  /* 移动端隐藏 */
  @media (max-width: 767px) {
    .doc-sidebar {
      display: none;
    }
  }
</style>
