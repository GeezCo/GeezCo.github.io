---
import { site } from "../site.config";
---

<footer class="bg-zinc-100 dark:bg-zinc-800/50 border-t border-zinc-200 dark:border-zinc-800 py-8 mt-12">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <div class="text-zinc-500 dark:text-zinc-400 text-sm">
        © {new Date().getFullYear()} {site.author}
      </div>
      <div class="flex items-center gap-4 text-sm">
        <a href="/rss.xml" class="text-zinc-500 hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400">
          RSS
        </a>
        <a href="/sponsor" class="text-amber-500 hover:text-amber-600 dark:text-amber-400">
          ☕ 赞赏支持
        </a>
        <a href="https://buymeacoffee.com/wincy" target="_blank" rel="noopener" class="text-zinc-500 hover:text-indigo-600 dark:text-zinc-400 dark:hover:text-indigo-400">
          Buy Me a Coffee
        </a>
      </div>
    </div>
  </div>
</footer>