---
import { site } from "../site.config";
---

<footer class="footer">
  <div class="footer-content">
    <div class="copyright">
      © {new Date().getFullYear()} {site.author}
    </div>
    <div class="footer-links">
      <a href="/rss.xml">RSS</a>
      <a href="https://github.com/GeezCo" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: #f4f4f5;
    border-top: 1px solid #e4e4e7;
    padding: 2rem 1rem;
    margin-top: 3rem;
  }
  :global(html.dark) .footer {
    background-color: #27272a;
    border-top-color: #3f3f46;
  }
  .footer-content {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .copyright {
    color: #71717a;
    font-size: 0.875rem;
  }
  :global(html.dark) .copyright {
    color: #a1a1aa;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
    font-size: 0.875rem;
  }
  .footer-links a {
    color: #71717a;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: #3b82f6;
  }
  :global(html.dark) .footer-links a {
    color: #a1a1aa;
  }
  :global(html.dark) .footer-links a:hover {
    color: #60a5fa;
  }
  .footer-links a:nth-child(2) {
    color: #f59e0b;
  }
</style>