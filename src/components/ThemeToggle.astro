---
// 主题切换按钮
---

<button
  id="theme-toggle"
  class="p-2 rounded-lg bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
  aria-label="切换主题"
>
  <span class="dark:hidden">🌙</span>
  <span class="hidden dark:inline">☀️</span>
</button>

<script is:inline>
  // 主题切换逻辑
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;

  // 防止快速连续点击
  let isTransitioning = false;

  // 初始化：检查本地存储或系统偏好
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark') {
    html.classList.add('dark');
  } else if (savedTheme === 'light') {
    html.classList.remove('dark');
  } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
    html.classList.add('dark');
  }

  // 主题切换函数
  function toggleTheme() {
    html.classList.toggle('dark');
    const isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: isDark ? 'dark' : 'light' } }));
  }

  // 点击切换（带圆形擦除动画）
  toggle.addEventListener('click', (e) => {
    // 防止快速连续点击
    if (isTransitioning) return;

    // 检查 reduced-motion 偏好
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 检查 API 支持
    if (!document.startViewTransition || prefersReducedMotion) {
      toggleTheme();
      return;
    }

    // 获取点击坐标
    const x = e.clientX;
    const y = e.clientY;

    // 计算到屏幕最远角的距离作为最大半径
    const radius = Math.sqrt(
      Math.max(x, window.innerWidth - x) ** 2 +
      Math.max(y, window.innerHeight - y) ** 2
    );

    // 设置 CSS 变量
    document.documentElement.style.setProperty('--x', `${x}px`);
    document.documentElement.style.setProperty('--y', `${y}px`);
    document.documentElement.style.setProperty('--r', `${radius}px`);

    // 启动过渡
    isTransitioning = true;
    const transition = document.startViewTransition(() => {
      toggleTheme();
    });

    transition.finished.finally(() => {
      isTransitioning = false;
    });
  });

  // 监听系统偏好变化（不播放动画）
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      toggleTheme();
    }
  });
</script>

<style>
  #theme-toggle {
    cursor: pointer;
    font-size: 1rem;
  }
</style>

<style is:global>
  /* View Transitions API: 禁用默认交叉淡入淡出动画 */
  ::view-transition-old(root) {
    animation: none;
    opacity: 1;
    mix-blend-mode: normal;
    z-index: 1;
  }

  /* 新视图应用圆形擦除动画 */
  ::view-transition-new(root) {
    opacity: 1;
    mix-blend-mode: normal;
    z-index: 2;
    animation: reveal-circular var(--transition-duration, 600ms) ease-in-out;
  }

  @keyframes reveal-circular {
    from {
      clip-path: circle(0px at var(--x) var(--y));
    }
    to {
      clip-path: circle(var(--r) at var(--x) var(--y));
    }
  }

  /* 尊重用户的减少动画偏好 */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-new(root) {
      animation: none !important;
    }
  }
</style>