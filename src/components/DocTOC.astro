---
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocItem[];
}

const { headings } = Astro.props;

// 只显示 h2 和 h3
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <aside class="doc-toc">
    <nav class="toc-nav">
      <h4 class="toc-title">目录</h4>
      <ul class="toc-list">
        {tocHeadings.map((heading) => (
          <li class:list={["toc-item", `toc-depth-${heading.depth}`]}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </aside>
)}

<script>
  // TOC 滚动高亮
  function initTocHighlight() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.getAttribute('id');
          const tocLink = document.querySelector(`.toc-link[href="#${id}"]`);

          if (entry.isIntersecting) {
            // 移除所有 active
            document.querySelectorAll('.toc-link').forEach(link => {
              link.classList.remove('active');
            });
            // 添加当前 active
            tocLink?.classList.add('active');
          }
        });
      },
      {
        rootMargin: '-100px 0px -66%',
        threshold: 1
      }
    );

    // 观察所有标题
    document.querySelectorAll('h2[id], h3[id]').forEach((heading) => {
      observer.observe(heading);
    });
  }

  // 页面加载后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTocHighlight);
  } else {
    initTocHighlight();
  }
</script>

<style>
  .doc-toc {
    width: 200px;
    height: 100vh;
    position: sticky;
    top: 0;
    overflow-y: auto;
    padding: 2rem 0 2rem 1.5rem;
  }

  .toc-nav {
    position: sticky;
    top: 2rem;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #71717a;
    margin: 0 0 1rem 0;
  }
  :global(html.dark) .toc-title {
    color: #a1a1aa;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    margin-bottom: 0.5rem;
  }

  .toc-link {
    display: block;
    color: #71717a;
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.5;
    transition: color 0.2s;
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
  }
  .toc-link:hover {
    color: #18181b;
  }
  .toc-link.active {
    color: #3b82f6;
    border-left-color: #3b82f6;
    font-weight: 500;
  }
  :global(html.dark) .toc-link {
    color: #a1a1aa;
  }
  :global(html.dark) .toc-link:hover {
    color: #fafafa;
  }
  :global(html.dark) .toc-link.active {
    color: #60a5fa;
    border-left-color: #60a5fa;
  }

  /* h3 缩进 */
  .toc-depth-3 .toc-link {
    padding-left: 1.5rem;
    font-size: 0.75rem;
  }

  /* 滚动条样式 */
  .doc-toc::-webkit-scrollbar {
    width: 4px;
  }
  .doc-toc::-webkit-scrollbar-track {
    background: transparent;
  }
  .doc-toc::-webkit-scrollbar-thumb {
    background: #d4d4d8;
    border-radius: 2px;
  }
  :global(html.dark) .doc-toc::-webkit-scrollbar-thumb {
    background: #3f3f46;
  }

  /* 平板和移动端隐藏 */
  @media (max-width: 1279px) {
    .doc-toc {
      display: none;
    }
  }
</style>
