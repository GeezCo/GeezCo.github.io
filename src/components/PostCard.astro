---
interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
}

const { title, description, pubDate, slug, tags = [] } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="post-card">
  <a href={`/blog/${slug}`}>
    <h2 class="post-title">{title}</h2>
    {description && <p class="post-desc">{description}</p>}
    <div class="post-meta">
      <time>{formattedDate}</time>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.slice(0, 2).map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .post-card {
    background-color: #ffffff;
    border-radius: 0.75rem;
    padding: 1.5rem;
    border: 1px solid #e4e4e7;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: box-shadow 0.3s;
  }
  .post-card:hover {
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .post-card {
    background-color: rgba(39, 39, 42, 0.5);
    border-color: rgba(63, 63, 70, 0.5);
  }
  .post-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }
  :global(html.dark) .post-title {
    color: #fafafa;
  }
  .post-card a:hover .post-title {
    color: #6366f1;
  }
  :global(html.dark) .post-card a:hover .post-title {
    color: #818cf8;
  }
  .post-desc {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }
  :global(html.dark) .post-desc {
    color: #a1a1aa;
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: #a1a1aa;
  }
  :global(html.dark) .post-meta {
    color: #71717a;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
  }
  .post-tags span {
    background-color: #f4f4f5;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }
  :global(html.dark) .post-tags span {
    background-color: #3f3f46;
  }
</style>