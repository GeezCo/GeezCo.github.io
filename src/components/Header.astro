---
import { site } from "../site.config";
import ThemeToggle from "./ThemeToggle.astro";
import NavDropdown from "./NavDropdown.astro";
import MobileMenu from "./MobileMenu.astro";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo">{site.title}</a>

    <!-- 桌面端导航 -->
    <div class="nav-links desktop-nav">
      <button class="search-trigger" onclick="window.openSearch?.()" title="搜索 (Ctrl+K / ⌘K)">
        <svg class="search-trigger-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-trigger-text">搜索</span>
        <kbd class="search-trigger-kbd" id="search-kbd">⌘K</kbd>
      </button>

      <!-- 首页下拉菜单 -->
      <div class="nav-dropdown-wrapper">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>首页</a>
        <NavDropdown />
      </div>

      <a href="/about" class={`nav-link ${currentPath === '/about' ? 'active' : ''}`}>关于</a>
      <a href="/sponsor" class={`nav-link highlight ${currentPath === '/sponsor' ? 'active' : ''}`}>赞赏</a>

      <div class="font-size-toggle">
        <button class="font-size-btn" data-size="small" title="小字号">小</button>
        <button class="font-size-btn" data-size="medium" title="中字号">中</button>
        <button class="font-size-btn" data-size="large" title="大字号">大</button>
      </div>
      <ThemeToggle />
    </div>

    <!-- 移动端导航 -->
    <div class="mobile-nav">
      <button class="search-trigger mobile-search" onclick="window.openSearch?.()" title="搜索">
        <svg class="search-trigger-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>
      <ThemeToggle />
      <MobileMenu />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
  }
  :global(html.dark) .header {
    background-color: rgba(24, 24, 27, 0.8);
    border-bottom-color: #3f3f46;
  }
  .nav {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: color 0.2s;
  }
  .logo:hover {
    color: var(--color-secondary);
  }

  /* 桌面端导航 */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* 移动端导航 */
  .mobile-nav {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: flex;
    }
  }

  /* 导航链接 */
  .nav-link {
    color: var(--color-muted);
    font-size: 0.875rem;
    transition: color 0.2s;
    text-decoration: none;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-link.active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .nav-link.highlight {
    color: var(--color-accent);
  }

  .nav-link.highlight:hover {
    color: #d97706;
  }

  /* 下拉菜单容器 */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-wrapper:hover :global(.nav-dropdown) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-wrapper:focus-within :global(.nav-dropdown) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* 搜索按钮 */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #f4f4f5;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--color-muted);
    font-family: inherit;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .search-trigger:hover {
    background: #e4e4e7;
    border-color: var(--color-muted);
  }
  :global(html.dark) .search-trigger {
    background: #27272a;
    border-color: #3f3f46;
    color: #a1a1aa;
  }
  :global(html.dark) .search-trigger:hover {
    background: #3f3f46;
    border-color: var(--color-primary);
  }
  .search-trigger-icon {
    flex-shrink: 0;
  }
  .search-trigger-kbd {
    font-size: 0.65rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    color: var(--color-muted);
    white-space: nowrap;
  }
  :global(html.dark) .search-trigger-kbd {
    background: #18181b;
    border-color: #3f3f46;
    color: #a1a1aa;
  }

  /* 移动端搜索按钮 */
  .mobile-search .search-trigger-text,
  .mobile-search .search-trigger-kbd {
    display: none;
  }
  .mobile-search {
    padding: 0.5rem;
  }

  /* 字体大小切换按钮 */
  .font-size-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: #f4f4f5;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.25rem;
  }
  :global(html.dark) .font-size-toggle {
    background: #27272a;
    border-color: #3f3f46;
  }
  .font-size-btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    background: transparent;
    border: none;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .font-size-btn:hover {
    color: var(--color-primary);
    background: rgba(83, 58, 253, 0.1);
  }
  .font-size-btn.active {
    color: white;
    background: var(--color-primary);
  }
  :global(html.dark) .font-size-btn {
    color: #a1a1aa;
  }
  :global(html.dark) .font-size-btn:hover {
    color: var(--color-primary);
    background: rgba(83, 58, 253, 0.2);
  }
</style>

<script>
  // 根据操作系统动态设置快捷键提示
  document.addEventListener('DOMContentLoaded', () => {
    const kbd = document.getElementById('search-kbd');
    if (kbd) {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0
                 || navigator.userAgent.toUpperCase().indexOf('MAC') >= 0;
      kbd.textContent = isMac ? '⌘K' : 'Ctrl+K';
    }

    // 字体大小切换功能
    const fontSizeBtns = document.querySelectorAll('.font-size-btn');
    const htmlEl = document.documentElement;

    // 从 localStorage 加载字体大小偏好，默认为 medium
    const savedSize = localStorage.getItem('fontSize') || 'medium';
    setFontSize(savedSize);

    // 绑定按钮点击事件
    fontSizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const size = btn.dataset.size;
        setFontSize(size);
        localStorage.setItem('fontSize', size);
      });
    });

    function setFontSize(size) {
      // 移除所有字体大小类
      htmlEl.classList.remove('font-small', 'font-medium', 'font-large');

      // 添加对应的类
      htmlEl.classList.add(`font-${size}`);

      // 更新按钮状态
      fontSizeBtns.forEach(btn => {
        if (btn.dataset.size === size) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }
  });
</script>