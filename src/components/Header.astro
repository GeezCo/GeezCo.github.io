---
import { site } from "../site.config";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo">{site.title}</a>
    <div class="nav-links">
      <a href="/">首页</a>
      <button class="search-trigger" onclick="window.__searchOpen?.()" title="搜索 (Ctrl+K / ⌘K)">
        <svg class="search-trigger-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="search-trigger-text">搜索</span>
        <kbd class="search-trigger-kbd" id="search-kbd">⌘K</kbd>
      </button>
      <a href="/about">关于</a>
      <a href="/tools">工具</a>
      <a href="/sponsor" class="highlight">赞赏</a>
      <a href="/rss.xml" target="_blank">RSS</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(250, 250, 250, 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e4e4e7;
    padding: 1rem;
  }
  :global(html.dark) .header {
    background-color: rgba(24, 24, 27, 0.8);
    border-bottom-color: #3f3f46;
  }
  .nav {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: #6366f1;
    transition: color 0.2s;
  }
  .logo:hover {
    color: #4f46e5;
  }
  :global(html.dark) .logo {
    color: #818cf8;
  }
  :global(html.dark) .logo:hover {
    color: #6366f1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-links a {
    color: #71717a;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: #6366f1;
  }
  :global(html.dark) .nav-links a {
    color: #a1a1aa;
  }
  :global(html.dark) .nav-links a:hover {
    color: #818cf8;
  }
  .nav-links .highlight {
    color: #f59e0b;
  }
  .nav-links .highlight:hover {
    color: #d97706;
  }

  /* 搜索按钮 */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font-size: 0.8rem;
    color: #71717a;
    font-family: inherit;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .search-trigger:hover {
    background: #e4e4e7;
    border-color: #d4d4d8;
  }
  :global(html.dark) .search-trigger {
    background: #3f3f46;
    border-color: #52525b;
    color: #a1a1aa;
  }
  :global(html.dark) .search-trigger:hover {
    background: #52525b;
    border-color: #71717a;
  }
  .search-trigger-icon {
    flex-shrink: 0;
  }
  .search-trigger-kbd {
    font-size: 0.65rem;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 0.25rem;
    padding: 0.1rem 0.3rem;
    color: #a1a1aa;
    white-space: nowrap;
  }
  :global(html.dark) .search-trigger-kbd {
    background: #18181b;
    border-color: #3f3f46;
    color: #71717a;
  }
  @media (max-width: 640px) {
    .search-trigger-text {
      display: none;
    }
    .search-trigger-kbd {
      display: none;
    }
  }

  /* 移动端适配 */
  @media (max-width: 640px) {
    .nav {
      gap: 0.5rem;
    }
    .logo {
      font-size: 1.1rem;
    }
    .nav-links {
      gap: 0.6rem;
    }
    .nav-links a {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // 根据操作系统动态设置快捷键提示
  document.addEventListener('DOMContentLoaded', () => {
    const kbd = document.getElementById('search-kbd');
    if (kbd) {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0
                 || navigator.userAgent.toUpperCase().indexOf('MAC') >= 0;
      kbd.textContent = isMac ? '⌘K' : 'Ctrl+K';
    }
  });
</script>