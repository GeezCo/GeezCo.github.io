---
import { site } from "../site.config";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header">
  <nav class="nav">
    <a href="/" class="logo">{site.title}</a>
    <div class="nav-links">
      <a href="/">首页</a>
      <a href="/search">搜索</a>
      <a href="/about">关于</a>
      <a href="/sponsor" class="highlight">赞赏</a>
      <a href="/rss.xml" target="_blank">RSS</a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(250, 250, 250, 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e4e4e7;
    padding: 1rem;
  }
  :global(html.dark) .header {
    background-color: rgba(24, 24, 27, 0.8);
    border-bottom-color: #3f3f46;
  }
  .nav {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: #6366f1;
    transition: color 0.2s;
  }
  .logo:hover {
    color: #4f46e5;
  }
  :global(html.dark) .logo {
    color: #818cf8;
  }
  :global(html.dark) .logo:hover {
    color: #6366f1;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-links a {
    color: #71717a;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: #6366f1;
  }
  :global(html.dark) .nav-links a {
    color: #a1a1aa;
  }
  :global(html.dark) .nav-links a:hover {
    color: #818cf8;
  }
  .nav-links .highlight {
    color: #f59e0b;
  }
  .nav-links .highlight:hover {
    color: #d97706;
  }

  /* 移动端适配 */
  @media (max-width: 640px) {
    .nav {
      gap: 0.5rem;
    }
    .logo {
      font-size: 1.1rem;
    }
    .nav-links {
      gap: 0.6rem;
    }
    .nav-links a {
      font-size: 0.75rem;
    }
  }
</style>