---
import { site } from "../site.config";
---

<header>
  <nav>
    <a href="/">{site.title}</a>
    <div class="links">
      <a href="/">首页</a>
      <a href="/about">关于</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem;
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  nav > a {
    font-weight: bold;
    font-size: 1.2rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
</style>