---
// 全局搜索弹窗 - Pagefind 自定义 UI
---
<div id="search-modal" class="search-overlay">
  <div class="search-modal" role="dialog" aria-label="搜索文章">
    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" id="search-input" placeholder="搜索文章..." autocomplete="off" />
      <kbd class="search-kbd">Esc</kbd>
    </div>
    <div id="search-results"></div>
    <div id="search-empty" class="search-empty">输入关键词开始搜索</div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');

    let pagefind = null;

    // 初始化 Pagefind
    async function initPagefind() {
      if (!pagefind) {
        // 动态加载 Pagefind 脚本
        if (!window.pagefind) {
          await new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = '/pagefind/pagefind.js';
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
          });
        }
        pagefind = window.pagefind;
      }
    }

    // 打开搜索弹窗
    function open() {
      overlay.classList.add('active');
      input.focus();
      document.body.style.overflow = 'hidden';
      if (!pagefind) {
        initPagefind().then(() => {
          // 初始化完成，等待用户输入
        });
      }
    }

    // 关闭搜索弹窗
    function close() {
      overlay.classList.remove('active');
      input.value = '';
      results.innerHTML = '';
      empty.textContent = '输入关键词开始搜索';
      empty.style.display = 'block';
      document.body.style.overflow = '';
    }

    // 搜索
    let debounceTimer;
    async function doSearch(query) {
      if (!pagefind) return;
      if (!query.trim()) {
        results.innerHTML = '';
        empty.textContent = '输入关键词开始搜索';
        empty.style.display = 'block';
        return;
      }

      // 使用正确的 Pagefind API: search() 方法
      const search = await pagefind.search(query);

      if (!search || !search.results || search.results.length === 0) {
        results.innerHTML = '';
        empty.textContent = '未找到相关文章';
        empty.style.display = 'block';
        return;
      }

      const searchResults = search.results.slice(0, 8);
      empty.style.display = 'none';

      // 加载每个结果的完整数据
      const data = await Promise.all(searchResults.map(r => r.data()));
      results.innerHTML = data.map(d => `
        <a href="${d.url}" class="search-result-item">
          <span class="search-result-title">${d.meta.title || '无标题'}</span>
          <span class="search-result-excerpt">${d.excerpt ? d.excerpt.replace(/<\/?mark>/g, '') : ''}</span>
        </a>
      `).join('');
    }

    // 事件
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => doSearch(input.value), 200);
    });

    // 快捷键
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        close();
      }
    });

    // 点击遮罩关闭
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // 暴露到全局
    window.__searchOpen = open;
    window.__searchClose = close;
  });
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    display: none;
    justify-content: center;
    padding-top: 15vh;
  }
  .search-overlay.active {
    display: flex;
  }

  .search-modal {
    width: 90vw;
    max-width: 560px;
    max-height: 70vh;
    background: #ffffff;
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  :global(html.dark) .search-modal {
    background: #27272a;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e4e4e7;
  }
  :global(html.dark) .search-input-wrap {
    border-bottom-color: #3f3f46;
  }

  .search-icon {
    color: #a1a1aa;
    flex-shrink: 0;
  }

  #search-input {
    flex: 1;
    border: none;
    outline: none;
    font-size: 1rem;
    background: transparent;
    color: #18181b;
    font-family: inherit;
  }
  :global(html.dark) #search-input {
    color: #fafafa;
  }
  #search-input::placeholder {
    color: #a1a1aa;
  }

  .search-kbd {
    font-size: 0.7rem;
    color: #a1a1aa;
    background: #f4f4f5;
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid #e4e4e7;
    white-space: nowrap;
  }
  :global(html.dark) .search-kbd {
    background: #3f3f46;
    border-color: #52525b;
  }

  #search-results {
    overflow-y: auto;
    max-height: 50vh;
  }

  .search-result-item {
    display: block;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    transition: background-color 0.15s;
    border-bottom: 1px solid #f4f4f5;
  }
  :global(html.dark) .search-result-item {
    border-bottom-color: #3f3f46;
  }
  .search-result-item:hover {
    background-color: #f4f4f5;
  }
  :global(html.dark) .search-result-item:hover {
    background-color: #3f3f46;
  }

  .search-result-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.25rem;
  }
  :global(html.dark) .search-result-title {
    color: #fafafa;
  }

  .search-result-excerpt {
    display: block;
    font-size: 0.8rem;
    color: #71717a;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  :global(html.dark) .search-result-excerpt {
    color: #a1a1aa;
  }

  .search-empty {
    display: block;
    text-align: center;
    padding: 3rem 1rem;
    color: #a1a1aa;
    font-size: 0.9rem;
  }

  .search-result-item .search-result-title {
    color: #18181b;
  }
</style>