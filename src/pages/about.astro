---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout title="关于" description="关于本博客">
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4">关于</h1>
    <p class="text-gray-600 mb-4">欢迎来到 {site.title}，一个记录技术与生活的博客。</p>
    <p class="text-gray-600">作者：{site.author}</p>
  </section>
</BaseLayout>