---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout title="关于" description="关于本博客">
  <section class="about-page">
    <article class="about-card">
      <h1>关于我</h1>
      <p class="intro">Hi，我是 <strong class="site-name">Wincy</strong>，一名全栈开发者。</p>
      <p class="desc">专注于后端开发与分布式系统，热爱技术、咖啡和开源。目前在深入学习 Go、ElasticSearch 和系统设计。</p>

      <div class="tech-stack">
        <h3>🛠️ 技术栈</h3>
        <div class="tech-group">
          <span class="tech-label">语言</span>
          <span class="tech-tags">Java · Python · Rust · React </span>
        </div>
        <div class="tech-group">
          <span class="tech-label">后端及中间件</span>
          <span class="tech-tags">Spring · Redis · Minio · Kafka · Docker ...</span>
        </div>
        <div class="tech-group">
          <span class="tech-label">前端</span>
          <span class="tech-tags">React · Rust · CSS/HTML/JS </span>
        </div>
        <div class="tech-group">
          <span class="tech-label">数据库</span>
          <span class="tech-tags">MySQL · PostgreSQL · MongoDB · ElasticSearch</span>
        </div>
      </div>

      <div class="resume">
        <h3>📄 简历</h3>
        <div id="resume-area">
          <div id="resume-locked">
            <p class="resume-hint">请输入密码以查看简历</p>
            <div class="resume-password-row">
              <input
                type="password"
                id="resume-password"
                placeholder="请输入密码"
                class="resume-input"
              />
              <button id="resume-submit" class="resume-btn">验证</button>
            </div>
            <p id="resume-error" class="resume-error hidden">密码错误，请重试</p>
          </div>
          <div id="resume-unlocked" class="hidden">
            <div class="resume-links">
              <a id="resume-download-zh" class="resume-link">📥 中文简历</a>
              <a id="resume-download-en" class="resume-link resume-link-en">📥 英文简历</a>
            </div>
            <p id="resume-expired" class="resume-error hidden">Token 已过期，请重新输入密码</p>
          </div>
        </div>
      </div>
      <div class="links">
        <h3>🔗 其他链接</h3>
        <div class="link-items">
          <a href="mailto:getperfectjob@yeah.net">📧 邮箱</a>
          <span class="link-text">💬 微信：MuchBliss</span>
          <a href="https://github.com/ProcessMonitor" target="_blank">🐙 GitHub</a>
          <a href="https://buymeacoffee.com/wincy" target="_blank">☕ Buy Me a Coffee</a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

<script>
  const locked = document.getElementById('resume-locked')!;
  const unlocked = document.getElementById('resume-unlocked')!;
  const passwordInput = document.getElementById('resume-password') as HTMLInputElement;
  const submitBtn = document.getElementById('resume-submit')!;
  const errorEl = document.getElementById('resume-error')!;
  const downloadLinkZh = document.getElementById('resume-download-zh') as HTMLAnchorElement;
  const downloadLinkEn = document.getElementById('resume-download-en') as HTMLAnchorElement;
  const expiredEl = document.getElementById('resume-expired')!;

  const TOKEN_KEY = 'resume_token';

  // 检查是否已有有效 token
  async function checkToken(token: string) {
    try {
      const res = await fetch('/api/resume-download?lang=zh', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      return res.ok;
    } catch {
      return false;
    }
  }

  async function tryAutoUnlock() {
    const token = sessionStorage.getItem(TOKEN_KEY);
    if (token && await checkToken(token)) {
      showUnlocked(token);
    }
  }

  async function downloadResume(lang: string) {
    const token = sessionStorage.getItem(TOKEN_KEY);
    if (!token) {
      locked.classList.remove('hidden');
      unlocked.classList.add('hidden');
      return;
    }

    try {
      const res = await fetch(`/api/resume-download?lang=${lang}`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (res.status === 401) {
        sessionStorage.removeItem(TOKEN_KEY);
        locked.classList.remove('hidden');
        unlocked.classList.add('hidden');
        expiredEl.classList.remove('hidden');
        return;
      }
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = lang === 'en' ? 'resume-en.pdf' : 'resume.pdf';
      a.click();
      URL.revokeObjectURL(url);
    } catch {
      // 网络错误，静默处理
    }
  }

  function showUnlocked(_token: string) {
    locked.classList.add('hidden');
    unlocked.classList.remove('hidden');
    expiredEl.classList.add('hidden');
  }

  function showError(msg?: string) {
    if (msg) errorEl.textContent = msg;
    else errorEl.textContent = '\u5bc6\u7801\u9519\u8bef\uff0c\u8bf7\u91cd\u8bd5';
    errorEl.classList.remove('hidden');
  }

  downloadLinkZh.addEventListener('click', (e) => {
    e.preventDefault();
    downloadResume('zh');
  });
  downloadLinkEn.addEventListener('click', (e) => {
    e.preventDefault();
    downloadResume('en');
  });

  submitBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const password = passwordInput.value;
    if (!password) return;

    try {
      const res = await fetch('/api/resume-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      if (res.status === 429) {
        const data = await res.json();
        showError(data.error || '\u8bf7\u6c42\u8fc7\u4e8e\u9891\u7e41');
        return;
      }

      if (!res.ok) {
        showError();
        return;
      }

      const { token } = await res.json();
      sessionStorage.setItem(TOKEN_KEY, token);
      showUnlocked(token);
    } catch {
      showError();
    }
  });

  passwordInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      submitBtn.click();
    }
  });

  // 页面加载时尝试自动解锁
  tryAutoUnlock();
</script>

<style>
  .about-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    padding: 4rem 1rem;
  }
  :global(html.dark) .about-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }
  .about-card {
    max-width: 56rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .about-card {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .about-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .about-card h1 {
    color: #fafafa;
  }
  .intro {
    font-size: 1.25rem;
    color: #71717a;
    margin-bottom: 1rem;
  }
  :global(html.dark) .intro {
    color: #a1a1aa;
  }
  .site-name {
    color: #6366f1;
  }
  :global(html.dark) .site-name {
    color: #818cf8;
  }
  .desc {
    color: #3f3f46;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .desc {
    color: #d4d4d8;
  }
  .tech-stack {
    background-color: #f4f4f5;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .tech-stack {
    background-color: #27272a;
  }
  .tech-stack h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 1rem;
  }
  :global(html.dark) .tech-stack h3 {
    color: #fafafa;
  }
  .tech-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }
  .tech-label {
    color: #6366f1;
    font-weight: 600;
    min-width: 3.5rem;
    flex-shrink: 0;
  }
  :global(html.dark) .tech-label {
    color: #818cf8;
  }
  .tech-tags {
    color: #3f3f46;
  }
  :global(html.dark) .tech-tags {
    color: #d4d4d8;
  }
  .resume {
    background-color: #eef2ff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .resume {
    background-color: rgba(99, 102, 241, 0.15);
  }
  .resume h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .resume h3 {
    color: #fafafa;
  }
  .resume-link {
    display: inline-block;
    background-color: #6366f1;
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: background-color 0.2s;
    cursor: pointer;
  }
  .resume-link:hover {
    background-color: #4f46e5;
  }
  :global(html.dark) .resume-link {
    background-color: #818cf8;
  }
  :global(html.dark) .resume-link:hover {
    background-color: #6366f1;
  }
  .resume-link-en {
    background-color: #10b981;
  }
  .resume-link-en:hover {
    background-color: #059669;
  }
  :global(html.dark) .resume-link-en {
    background-color: #34d399;
    color: #18181b;
  }
  :global(html.dark) .resume-link-en:hover {
    background-color: #10b981;
  }
  .resume-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .resume-hint {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .resume-hint {
    color: #a1a1aa;
  }
  .resume-password-row {
    display: flex;
    gap: 0.5rem;
  }
  .resume-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    background-color: #ffffff;
    color: #18181b;
    outline: none;
    transition: border-color 0.2s;
  }
  .resume-input:focus {
    border-color: #6366f1;
  }
  :global(html.dark) .resume-input {
    background-color: #3f3f46;
    color: #fafafa;
    border-color: #52525b;
  }
  :global(html.dark) .resume-input:focus {
    border-color: #818cf8;
  }
  .resume-btn {
    padding: 0.5rem 1rem;
    background-color: #6366f1;
    color: #ffffff;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .resume-btn:hover {
    background-color: #4f46e5;
  }
  :global(html.dark) .resume-btn {
    background-color: #818cf8;
  }
  :global(html.dark) .resume-btn:hover {
    background-color: #6366f1;
  }
  .resume-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .hidden {
    display: none;
  }
  .links {
    background-color: #f4f4f5;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  :global(html.dark) .links {
    background-color: #27272a;
  }
  .links h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .links h3 {
    color: #fafafa;
  }
  .link-items {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .link-items a {
    color: #6366f1;
    transition: color 0.2s;
  }
  .link-items a:hover {
    color: #4f46e5;
  }
  :global(html.dark) .link-items a {
    color: #818cf8;
  }
  :global(html.dark) .link-items a:hover {
    color: #6366f1;
  }
  .link-text {
    color: #71717a;
    font-size: 0.875rem;
  }
  :global(html.dark) .link-text {
    color: #a1a1aa;
  }

  /* 移动端适配 */
  @media (max-width: 480px) {
    .about-card {
      padding: 1.25rem;
    }
    .resume-password-row {
      flex-direction: column;
    }
    .resume-btn {
      width: 100%;
    }
  }
</style>