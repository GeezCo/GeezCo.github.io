---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout title="关于" description="关于本博客">
  <section>
    <h1>关于</h1>
    <p>欢迎来到 {site.title}，一个记录技术与生活的博客。</p>
    <p>作者：{site.author}</p>
  </section>
</BaseLayout>

<style>
  section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
</style>