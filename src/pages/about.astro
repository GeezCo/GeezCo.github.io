---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
---

<BaseLayout title="关于" description="关于本博客">
  <section class="about-page">
    <article class="about-card">
      <h1>关于我</h1>
      <p class="intro">欢迎来到 <strong class="site-name">{site.title}</strong>！</p>
      <p class="desc">这里是我记录技术学习、生活感悟的地方。主要分享：</p>
      <ul class="topics">
        <li>后端开发（Java、Go、Spring）</li>
        <li>数据库与缓存（MySQL、Redis、ES）</li>
        <li>技术面试经验</li>
        <li>其他感兴趣的技术话题</li>
      </ul>
      <div class="resume">
        <h3>📄 简历</h3>
        <div id="resume-area">
          <div id="resume-locked">
            <p class="resume-hint">请输入密码以查看简历</p>
            <div class="resume-password-row">
              <input
                type="password"
                id="resume-password"
                placeholder="请输入密码"
                class="resume-input"
              />
              <button id="resume-submit" class="resume-btn">验证</button>
            </div>
            <p id="resume-error" class="resume-error hidden">密码错误，请重试</p>
          </div>
          <div id="resume-unlocked" class="hidden">
            <a id="resume-download-link" class="resume-link">下载 PDF</a>
            <p id="resume-expired" class="resume-error hidden">Token 已过期，请重新输入密码</p>
          </div>
        </div>
      </div>
      <div class="links">
        <h3>🔗 其他链接</h3>
        <div class="link-items">
          <a href="mailto:getperfectjob@yeah.net">📧 邮箱</a>
          <span class="link-text">💬 微信：MuchBliss</span>
          <a href="https://github.com/ProcessMonitor" target="_blank">🐙 GitHub</a>
          <a href="https://buymeacoffee.com/wincy" target="_blank">☕ Buy Me a Coffee</a>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

<script>
  const locked = document.getElementById('resume-locked')!;
  const unlocked = document.getElementById('resume-unlocked')!;
  const passwordInput = document.getElementById('resume-password') as HTMLInputElement;
  const submitBtn = document.getElementById('resume-submit')!;
  const errorEl = document.getElementById('resume-error')!;
  const downloadLink = document.getElementById('resume-download-link') as HTMLAnchorElement;
  const expiredEl = document.getElementById('resume-expired')!;

  const TOKEN_KEY = 'resume_token';

  // 检查是否已有有效 token
  async function checkToken(token) {
    try {
      const res = await fetch(`/api/resume-download?token=${encodeURIComponent(token)}`, { method: 'HEAD' });
      return res.ok;
    } catch {
      return false;
    }
  }

  async function tryAutoUnlock() {
    const token = sessionStorage.getItem(TOKEN_KEY);
    if (token && await checkToken(token)) {
      showUnlocked(token);
    }
  }

  function showUnlocked(token) {
    locked.classList.add('hidden');
    unlocked.classList.remove('hidden');
    expiredEl.classList.add('hidden');
    downloadLink.href = `/api/resume-download?token=${encodeURIComponent(token)}`;
  }

  function showError() {
    errorEl.classList.remove('hidden');
  }

  submitBtn.addEventListener('click', async () => {
    errorEl.classList.add('hidden');
    const password = passwordInput.value;
    if (!password) return;

    try {
      const res = await fetch('/api/resume-verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });

      if (!res.ok) {
        showError();
        return;
      }

      const { token } = await res.json();
      sessionStorage.setItem(TOKEN_KEY, token);
      showUnlocked(token);
    } catch {
      showError();
    }
  });

  passwordInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      submitBtn.click();
    }
  });

  // 页面加载时尝试自动解锁
  tryAutoUnlock();
</script>

<style>
  .about-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    padding: 4rem 1rem;
  }
  :global(html.dark) .about-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }
  .about-card {
    max-width: 56rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .about-card {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .about-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .about-card h1 {
    color: #fafafa;
  }
  .intro {
    font-size: 1.25rem;
    color: #71717a;
    margin-bottom: 1rem;
  }
  :global(html.dark) .intro {
    color: #a1a1aa;
  }
  .site-name {
    color: #6366f1;
  }
  :global(html.dark) .site-name {
    color: #818cf8;
  }
  .desc {
    color: #3f3f46;
    margin-bottom: 1rem;
  }
  :global(html.dark) .desc {
    color: #d4d4d8;
  }
  .topics {
    color: #3f3f46;
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }
  :global(html.dark) .topics {
    color: #d4d4d8;
  }
  .topics li {
    margin-bottom: 0.5rem;
  }
  .resume {
    background-color: #eef2ff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .resume {
    background-color: rgba(99, 102, 241, 0.15);
  }
  .resume h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .resume h3 {
    color: #fafafa;
  }
  .resume-link {
    display: inline-block;
    background-color: #6366f1;
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: background-color 0.2s;
    cursor: pointer;
  }
  .resume-link:hover {
    background-color: #4f46e5;
  }
  :global(html.dark) .resume-link {
    background-color: #818cf8;
  }
  :global(html.dark) .resume-link:hover {
    background-color: #6366f1;
  }
  .resume-hint {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .resume-hint {
    color: #a1a1aa;
  }
  .resume-password-row {
    display: flex;
    gap: 0.5rem;
  }
  .resume-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    background-color: #ffffff;
    color: #18181b;
    outline: none;
    transition: border-color 0.2s;
  }
  .resume-input:focus {
    border-color: #6366f1;
  }
  :global(html.dark) .resume-input {
    background-color: #3f3f46;
    color: #fafafa;
    border-color: #52525b;
  }
  :global(html.dark) .resume-input:focus {
    border-color: #818cf8;
  }
  .resume-btn {
    padding: 0.5rem 1rem;
    background-color: #6366f1;
    color: #ffffff;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .resume-btn:hover {
    background-color: #4f46e5;
  }
  :global(html.dark) .resume-btn {
    background-color: #818cf8;
  }
  :global(html.dark) .resume-btn:hover {
    background-color: #6366f1;
  }
  .resume-error {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .hidden {
    display: none;
  }
  .links {
    background-color: #f4f4f5;
    border-radius: 0.5rem;
    padding: 1.5rem;
  }
  :global(html.dark) .links {
    background-color: #27272a;
  }
  .links h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .links h3 {
    color: #fafafa;
  }
  .link-items {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .link-items a {
    color: #6366f1;
    transition: color 0.2s;
  }
  .link-items a:hover {
    color: #4f46e5;
  }
  :global(html.dark) .link-items a {
    color: #818cf8;
  }
  :global(html.dark) .link-items a:hover {
    color: #6366f1;
  }
  .link-text {
    color: #71717a;
    font-size: 0.875rem;
  }
  :global(html.dark) .link-text {
    color: #a1a1aa;
  }
</style>