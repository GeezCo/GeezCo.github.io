---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Mermaid 图表工具" description="在线 Mermaid 图表渲染工具">
  <section class="tools-page">
    <div class="page">
      <div class="header">
        <h1>📊 Mermaid 图表工具</h1>
        <p class="subtitle">将 Mermaid 代码转换为 SVG/PNG 图表</p>
      </div>

      <div class="main">
        <div class="left-panel">
          <div class="panel-title">Mermaid 代码</div>
          <textarea id="codeInput" placeholder="粘贴 mermaid 代码..."></textarea>
          <div class="buttons">
            <button onclick="doPreview()">预览</button>
            <button onclick="doClear()" class="gray">清空</button>
            <button onclick="doDownloadSVG()" class="green">下载 SVG</button>
            <button onclick="doDownloadPNG()" class="orange">下载 PNG</button>
          </div>
          <div class="settings">
            <div class="settings-row">
              <label>文件名</label>
              <input type="text" id="fileName" value="diagram">
            </div>
            <div class="settings-row">
              <label>图片宽度</label>
              <input type="number" id="pngWidth" value="1920" min="400" max="4000">
            </div>
          </div>
          <div id="statusBar" class="status"></div>
        </div>

        <div class="right-panel">
          <div class="preview-header">
            <div class="panel-title">预览</div>
            <div class="zoom-box">
              <button onclick="zoomOut()" class="gray">-</button>
              <span id="zoomTxt">200%</span>
              <button onclick="zoomIn()" class="gray">+</button>
              <button onclick="zoomReset()" class="gray">重置</button>
            </div>
          </div>
          <div id="previewBox">
            <div id="preview">点击「预览」按钮查看图表</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>

<script is:inline>
  mermaid.initialize({ startOnLoad: false, theme: "default", securityLevel: "loose" });

  var cnt = 0;
  var svgData = "";
  var zoom = 2;

  function log(msg, type) {
    var el = document.getElementById("statusBar");
    if (!el) return;
    el.textContent = msg;
    el.className = "status " + (type || "");
  }

  function setZoom() {
    document.getElementById("zoomTxt").textContent = Math.round(zoom * 100) + "%";
    document.getElementById("preview").style.transform = "scale(" + zoom + ")";
  }

  function zoomIn() {
    if (zoom < 3) {
      zoom += 0.25;
      setZoom();
    }
  }

  function zoomOut() {
    if (zoom > 0.5) {
      zoom -= 0.25;
      setZoom();
    }
  }

  function zoomReset() {
    zoom = 2;
    setZoom();
  }

  async function doPreview() {
    var code = document.getElementById("codeInput").value.trim();
    if (!code) {
      log("请输入 Mermaid 代码", "error");
      return;
    }

    try {
      cnt++;
      var id = "mermaid-" + cnt;
      var { svg } = await mermaid.render(id, code);
      svgData = svg;
      document.getElementById("preview").innerHTML = svg;
      log("渲染成功", "success");
    } catch (e) {
      log("渲染失败: " + e.message, "error");
      console.error(e);
    }
  }

  function doClear() {
    document.getElementById("codeInput").value = "";
    document.getElementById("preview").innerHTML = "点击「预览」按钮查看图表";
    svgData = "";
    log("");
  }

  function doDownloadSVG() {
    if (!svgData) {
      log("请先预览图表", "error");
      return;
    }
    var fileName = document.getElementById("fileName").value || "diagram";
    var blob = new Blob([svgData], { type: "image/svg+xml" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = fileName + ".svg";
    a.click();
    URL.revokeObjectURL(url);
    log("SVG 下载成功", "success");
  }

  function doDownloadPNG() {
    if (!svgData) {
      log("请先预览图表", "error");
      return;
    }

    var fileName = document.getElementById("fileName").value || "diagram";
    var width = parseInt(document.getElementById("pngWidth").value) || 1920;

    var parser = new DOMParser();
    var doc = parser.parseFromString(svgData, "image/svg+xml");
    var svgEl = doc.documentElement;

    var viewBox = svgEl.getAttribute("viewBox");
    var vbArr = viewBox ? viewBox.split(/\s+/) : [];
    var vbW = parseFloat(vbArr[2]) || 800;
    var vbH = parseFloat(vbArr[3]) || 600;
    var ratio = vbH / vbW;
    var height = Math.round(width * ratio);

    var canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    var ctx = canvas.getContext("2d");

    var img = new Image();
    img.onload = function() {
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, width, height);
      ctx.drawImage(img, 0, 0, width, height);

      canvas.toBlob(function(blob) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement("a");
        a.href = url;
        a.download = fileName + ".png";
        a.click();
        URL.revokeObjectURL(url);
        log("PNG 下载成功", "success");
      });
    };
    img.onerror = function() {
      log("PNG 转换失败", "error");
    };

    var svgBlob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });
    var svgUrl = URL.createObjectURL(svgBlob);
    img.src = svgUrl;
  }

  setZoom();
</script>

<style>
  .tools-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    min-height: 100vh;
    padding: 2rem 1rem;
  }
  :global(html.dark) .tools-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }

  .page {
    max-width: 90rem;
    margin: 0 auto;
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
  }

  .header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 0.5rem;
  }
  :global(html.dark) h1 {
    color: #fafafa;
  }

  .subtitle {
    color: #71717a;
    font-size: 0.9375rem;
  }
  :global(html.dark) .subtitle {
    color: #a1a1aa;
  }

  .main {
    display: flex;
    gap: 1rem;
    flex: 1;
    min-height: 0;
  }

  .left-panel {
    width: 35%;
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .left-panel {
    background: rgba(39, 39, 42, 0.7);
  }

  .right-panel {
    flex: 1;
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .right-panel {
    background: rgba(39, 39, 42, 0.7);
  }

  .panel-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .panel-title {
    color: #fafafa;
  }

  textarea {
    flex: 1;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 0.75rem;
    font-family: "Courier New", monospace;
    font-size: 0.875rem;
    resize: none;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) textarea {
    background: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
  }

  .buttons {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    background: #3b82f6;
    color: white;
    transition: all 0.2s;
  }
  button:hover {
    background: #4f46e5;
  }
  button.gray {
    background: #71717a;
  }
  button.gray:hover {
    background: #52525b;
  }
  button.green {
    background: #10b981;
  }
  button.green:hover {
    background: #059669;
  }
  button.orange {
    background: #f59e0b;
  }
  button.orange:hover {
    background: #d97706;
  }

  .settings {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .settings-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .settings-row label {
    font-size: 0.8125rem;
    color: #71717a;
    min-width: 4rem;
  }
  :global(html.dark) .settings-row label {
    color: #a1a1aa;
  }

  .settings-row input {
    flex: 1;
    padding: 0.375rem 0.5rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
  }
  :global(html.dark) .settings-row input {
    background: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
  }

  .status {
    font-size: 0.8125rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    min-height: 1.75rem;
  }
  .status.success {
    background: #f0fdf4;
    color: #16a34a;
  }
  .status.error {
    background: #fef2f2;
    color: #dc2626;
  }
  :global(html.dark) .status.success {
    background: rgba(22, 163, 74, 0.15);
    color: #4ade80;
  }
  :global(html.dark) .status.error {
    background: rgba(220, 38, 38, 0.15);
    color: #f87171;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .zoom-box {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .zoom-box button {
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
  }

  .zoom-box span {
    font-size: 0.8125rem;
    color: #71717a;
    min-width: 3rem;
    text-align: center;
  }
  :global(html.dark) .zoom-box span {
    color: #a1a1aa;
  }

  #previewBox {
    flex: 1;
    overflow: auto;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 1rem;
    background: #fafafa;
  }
  :global(html.dark) #previewBox {
    background: #18181b;
    border-color: #3f3f46;
  }

  #preview {
    display: inline-block;
    transform-origin: top left;
  }

  #preview svg {
    max-width: none;
  }

  @media (max-width: 768px) {
    .main {
      flex-direction: column;
    }
    .left-panel {
      width: 100%;
    }
    .right-panel {
      min-height: 300px;
    }
  }
</style>
