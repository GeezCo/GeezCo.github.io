---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="ASCII Art 工具" description="将 ASCII 文本图转换为 SVG 矢量图">
  <section class="tools-page">
    <div class="page">
      <div class="header">
        <h1>🎨 ASCII Art 工具</h1>
        <p class="subtitle">将 ASCII 文本图转换为 SVG 矢量图</p>
      </div>

      <div class="main">
        <div class="left-panel">
          <div class="panel-header">
            <div class="panel-title">ASCII 输入</div>
            <div class="panel-actions">
              <select id="exampleSelect" onchange="loadExample()">
                <option value="">选择示例...</option>
                <option value="flow">简单流程</option>
                <option value="branch">带判断的流程</option>
                <option value="arch">系统架构</option>
                <option value="sequence">时序图</option>
                <option value="network">网络拓扑</option>
              </select>
              <select id="historySelect" onchange="loadHistory()">
                <option value="">历史记录...</option>
              </select>
            </div>
          </div>

          <textarea id="asciiInput" placeholder="输入 ASCII 文本图...

示例：
+-------+       +-------+
| Start |------>|  End  |
+-------+       +-------+
"></textarea>

          <div class="buttons">
            <button onclick="convertToSVG()">转换</button>
            <button onclick="clearInput()" class="gray">清空</button>
            <button onclick="downloadSVG()" class="green">下载 SVG</button>
            <button onclick="downloadPNG()" class="orange">下载 PNG</button>
          </div>

          <div class="settings">
            <div class="settings-row">
              <label>文件名</label>
              <input type="text" id="fileName" value="ascii-art">
            </div>
            <div class="settings-row">
              <label>图片宽度</label>
              <input type="number" id="imgWidth" value="1920" min="400" max="4000">
            </div>
          </div>

          <div id="statusBar" class="status"></div>

          <div class="syntax-help">
            <div class="help-title">💡 语法速查</div>
            <div class="help-content">
              <div class="help-item">
                <code>+---+</code> 矩形框
              </div>
              <div class="help-item">
                <code>----></code> 箭头
              </div>
              <div class="help-item">
                <code>|</code> 竖线
              </div>
              <div class="help-item">
                <code>/  \</code> 斜线
              </div>
            </div>
          </div>
        </div>

        <div class="right-panel">
          <div class="preview-header">
            <div class="panel-title">预览</div>
            <div class="zoom-box">
              <button onclick="zoomOut()" class="gray">-</button>
              <span id="zoomTxt">100%</span>
              <button onclick="zoomIn()" class="gray">+</button>
              <button onclick="zoomReset()" class="gray">重置</button>
            </div>
          </div>
          <div id="previewBox">
            <div id="preview">输入 ASCII 文本后点击转换</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import Bob from 'bob-wasm';

  let svgContent = "";
  let zoom = 1;

  const examples = {
    flow: `+-------+       +-------+
| Start |------>|  End  |
+-------+       +-------+`,
    branch: `    +------+
    | Init |
    +------+
       |
       v
    +------+
    | Test |
    +------+
     /   \\
    v     v
+----+  +----+
| OK |  | NG |
+----+  +----+`,
    arch: `+----------+     +----------+     +----------+
| Frontend |---->| Backend  |---->| Database |
+----------+     +----------+     +----------+`,
    sequence: `Client          Server          Database
  |               |                |
  |---request---->|                |
  |               |---query------->|
  |               |<--result-------|
  |<--response----|                |`,
    network: `        +--------+
        | Router |
        +--------+
         /  |  \\
        /   |   \\
       v    v    v
    +--+ +--+ +--+
    |PC| |PC| |PC|
    +--+ +--+ +--+`
  };

  function log(msg: string, type?: string) {
    const el = document.getElementById("statusBar");
    if (!el) return;
    el.textContent = msg;
    el.className = "status " + (type || "");
  }

  function setZoom() {
    const zoomTxt = document.getElementById("zoomTxt");
    const preview = document.getElementById("preview");
    if (zoomTxt) zoomTxt.textContent = Math.round(zoom * 100) + "%";
    if (preview) preview.style.transform = `scale(${zoom})`;
  }

  (window as any).zoomIn = function() {
    if (zoom < 3) {
      zoom += 0.25;
      setZoom();
    }
  };

  (window as any).zoomOut = function() {
    if (zoom > 0.25) {
      zoom -= 0.25;
      setZoom();
    }
  };

  (window as any).zoomReset = function() {
    zoom = 1;
    setZoom();
  };

  (window as any).loadExample = function() {
    const select = document.getElementById("exampleSelect") as HTMLSelectElement;
    const value = select.value;
    if (value && examples[value as keyof typeof examples]) {
      const input = document.getElementById("asciiInput") as HTMLTextAreaElement;
      input.value = examples[value as keyof typeof examples];
      select.value = "";
    }
  };

  (window as any).loadHistory = function() {
    const select = document.getElementById("historySelect") as HTMLSelectElement;
    const index = parseInt(select.value);
    if (!isNaN(index)) {
      const history = JSON.parse(localStorage.getItem("asciiHistory") || "[]");
      if (history[index]) {
        const input = document.getElementById("asciiInput") as HTMLTextAreaElement;
        input.value = history[index].text;
        select.value = "";
      }
    }
  };

  function saveToHistory(text: string) {
    let history = JSON.parse(localStorage.getItem("asciiHistory") || "[]");
    history.unshift({
      text: text,
      timestamp: Date.now()
    });
    history = history.slice(0, 10);
    localStorage.setItem("asciiHistory", JSON.stringify(history));
    updateHistorySelect();
  }

  function updateHistorySelect() {
    const select = document.getElementById("historySelect") as HTMLSelectElement;
    const history = JSON.parse(localStorage.getItem("asciiHistory") || "[]");

    select.innerHTML = '<option value="">历史记录...</option>';
    history.forEach((item: any, index: number) => {
      const date = new Date(item.timestamp);
      const preview = item.text.substring(0, 20).replace(/\n/g, " ");
      const option = document.createElement("option");
      option.value = index.toString();
      option.textContent = `${date.toLocaleString()} - ${preview}...`;
      select.appendChild(option);
    });
  }

  (window as any).convertToSVG = async function() {
    const input = document.getElementById("asciiInput") as HTMLTextAreaElement;
    const text = input.value.trim();

    if (!text) {
      log("请输入 ASCII 文本", "error");
      return;
    }

    try {
      svgContent = Bob.render(text);
      const preview = document.getElementById("preview");
      if (preview) preview.innerHTML = svgContent;

      saveToHistory(text);
      log("转换成功", "success");
    } catch (e: any) {
      log("转换失败: " + e.message, "error");
      console.error(e);
    }
  };

  (window as any).clearInput = function() {
    const input = document.getElementById("asciiInput") as HTMLTextAreaElement;
    input.value = "";
    const preview = document.getElementById("preview");
    if (preview) preview.innerHTML = "输入 ASCII 文本后点击转换";
    svgContent = "";
    log("");
  };

  (window as any).downloadSVG = function() {
    if (!svgContent) {
      log("请先转换 ASCII 文本", "error");
      return;
    }

    const fileName = (document.getElementById("fileName") as HTMLInputElement).value || "ascii-art";
    const blob = new Blob([svgContent], { type: "image/svg+xml" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = fileName + ".svg";
    a.click();
    URL.revokeObjectURL(url);
    log("SVG 下载成功", "success");
  };

  (window as any).downloadPNG = function() {
    if (!svgContent) {
      log("请先转换 ASCII 文本", "error");
      return;
    }

    const fileName = (document.getElementById("fileName") as HTMLInputElement).value || "ascii-art";
    const width = parseInt((document.getElementById("imgWidth") as HTMLInputElement).value) || 1920;

    const parser = new DOMParser();
    const doc = parser.parseFromString(svgContent, "image/svg+xml");
    const svgEl = doc.documentElement;

    const viewBox = svgEl.getAttribute("viewBox");
    const vbArr = viewBox ? viewBox.split(/\s+/) : [];
    const vbW = parseFloat(vbArr[2]) || 800;
    const vbH = parseFloat(vbArr[3]) || 600;
    const ratio = vbH / vbW;
    const height = Math.round(width * ratio);

    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext("2d");

    if (!ctx) {
      log("Canvas 初始化失败", "error");
      return;
    }

    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, width, height);

    const img = new Image();
    img.onload = function() {
      ctx.drawImage(img, 0, 0, width, height);

      canvas.toBlob(function(blob) {
        if (!blob) {
          log("PNG 生成失败", "error");
          return;
        }
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = fileName + ".png";
        a.click();
        URL.revokeObjectURL(url);
        log("PNG 下载成功", "success");
      });
    };

    img.onerror = function() {
      log("PNG 转换失败", "error");
    };

    const svgBlob = new Blob([svgContent], { type: "image/svg+xml;charset=utf-8" });
    const svgUrl = URL.createObjectURL(svgBlob);
    img.src = svgUrl;
  };

  // 初始化
  setZoom();
  updateHistorySelect();
</script>

<style>
  .tools-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    min-height: 100vh;
    padding: 2rem 1rem;
  }
  :global(html.dark) .tools-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }

  .page {
    max-width: 90rem;
    margin: 0 auto;
    height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;
  }

  .header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 0.5rem;
  }
  :global(html.dark) h1 {
    color: #fafafa;
  }

  .subtitle {
    color: #71717a;
    font-size: 0.9375rem;
  }
  :global(html.dark) .subtitle {
    color: #a1a1aa;
  }

  .main {
    display: flex;
    gap: 1rem;
    flex: 1;
    min-height: 0;
  }

  .left-panel {
    width: 40%;
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .left-panel {
    background: rgba(39, 39, 42, 0.7);
  }

  .right-panel {
    flex: 1;
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .right-panel {
    background: rgba(39, 39, 42, 0.7);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .panel-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #18181b;
  }
  :global(html.dark) .panel-title {
    color: #fafafa;
  }

  .panel-actions {
    display: flex;
    gap: 0.5rem;
  }

  .panel-actions select {
    padding: 0.25rem 0.5rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
    background: white;
    color: #18181b;
  }
  :global(html.dark) .panel-actions select {
    background: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
  }

  textarea {
    flex: 1;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 0.75rem;
    font-family: "Courier New", monospace;
    font-size: 0.875rem;
    resize: none;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  :global(html.dark) textarea {
    background: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
  }

  .buttons {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    background: #6366f1;
    color: white;
    transition: all 0.2s;
  }
  button:hover {
    background: #4f46e5;
  }
  button.gray {
    background: #71717a;
  }
  button.gray:hover {
    background: #52525b;
  }
  button.green {
    background: #10b981;
  }
  button.green:hover {
    background: #059669;
  }
  button.orange {
    background: #f59e0b;
  }
  button.orange:hover {
    background: #d97706;
  }

  .settings {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .settings-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .settings-row label {
    font-size: 0.8125rem;
    color: #71717a;
    min-width: 4rem;
  }
  :global(html.dark) .settings-row label {
    color: #a1a1aa;
  }

  .settings-row input {
    flex: 1;
    padding: 0.375rem 0.5rem;
    border: 1px solid #e4e4e7;
    border-radius: 0.375rem;
    font-size: 0.8125rem;
  }
  :global(html.dark) .settings-row input {
    background: #27272a;
    border-color: #3f3f46;
    color: #fafafa;
  }

  .status {
    font-size: 0.8125rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    min-height: 1.75rem;
    margin-bottom: 0.75rem;
  }
  .status.success {
    background: #f0fdf4;
    color: #16a34a;
  }
  .status.error {
    background: #fef2f2;
    color: #dc2626;
  }
  :global(html.dark) .status.success {
    background: rgba(22, 163, 74, 0.15);
    color: #4ade80;
  }
  :global(html.dark) .status.error {
    background: rgba(220, 38, 38, 0.15);
    color: #f87171;
  }

  .syntax-help {
    background: #f9fafb;
    border-radius: 0.5rem;
    padding: 0.75rem;
    border: 1px solid #e5e7eb;
  }
  :global(html.dark) .syntax-help {
    background: #27272a;
    border-color: #3f3f46;
  }

  .help-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 0.5rem;
  }
  :global(html.dark) .help-title {
    color: #fafafa;
  }

  .help-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.375rem;
  }

  .help-item {
    font-size: 0.75rem;
    color: #71717a;
  }
  :global(html.dark) .help-item {
    color: #a1a1aa;
  }

  .help-item code {
    background: #e5e7eb;
    padding: 0.125rem 0.25rem;
    border-radius: 0.25rem;
    font-family: "Courier New", monospace;
    margin-right: 0.25rem;
  }
  :global(html.dark) .help-item code {
    background: #3f3f46;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .zoom-box {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .zoom-box button {
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
  }

  .zoom-box span {
    font-size: 0.8125rem;
    color: #71717a;
    min-width: 3rem;
    text-align: center;
  }
  :global(html.dark) .zoom-box span {
    color: #a1a1aa;
  }

  #previewBox {
    flex: 1;
    overflow: auto;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 1rem;
    background: #fafafa;
  }
  :global(html.dark) #previewBox {
    background: #18181b;
    border-color: #3f3f46;
  }

  #preview {
    display: inline-block;
    transform-origin: top left;
  }

  #preview svg {
    max-width: none;
  }

  @media (max-width: 768px) {
    .main {
      flex-direction: column;
    }
    .left-panel {
      width: 100%;
    }
    .right-panel {
      min-height: 300px;
    }
    .help-content {
      grid-template-columns: 1fr;
    }
  }
</style>
