---
import PostLayout from "../../layouts/PostLayout.astro";
import LockScreen from "../../components/LockScreen.astro";
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import { encryptHtml, serializeEncrypted } from "../../lib/crypto";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, "");

let locked = false;
let encryptedContent = "";
let renderedContent: Awaited<ReturnType<typeof render>> | null = null;

if (post.data.locked) {
  if (!post.data.password) {
    throw new Error(
      `文章 "${post.data.title}" 设置了 locked=true 但未提供 password`,
    );
  }
  if (!post.body) {
    throw new Error(
      `文章 "${post.data.title}" 设置了 locked=true 但正文为空`,
    );
  }
  const renderedHtml = marked.parse(post.body, { gfm: true }) as string;
  const encrypted = encryptHtml(renderedHtml, post.data.password);
  encryptedContent = serializeEncrypted(encrypted);
  locked = true;
} else {
  renderedContent = await render(post);
}
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  locked={locked}
>
  {locked && <LockScreen encryptedContent={encryptedContent} slug={slug} />}
  {!locked && renderedContent && <renderedContent.Content />}
</PostLayout>