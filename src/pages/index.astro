---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 6);
---

<BaseLayout title={site.title} description={site.description}>
  <!-- Hero 区域 -->
  <section class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 dark:from-zinc-900 dark:via-zinc-900 dark:to-zinc-800 py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-zinc-900 dark:text-zinc-100 mb-4">
          {site.title}
        </h1>
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto mb-8">
          {site.description}
        </p>
        <div class="flex justify-center gap-4">
          <a href="/search" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white px-6 py-3 rounded-lg font-medium transition-colors">
            <span>🔍</span> 搜索文章
          </a>
          <a href="/about" class="inline-flex items-center gap-2 bg-zinc-200 hover:bg-zinc-300 dark:bg-zinc-700 dark:hover:bg-zinc-600 text-zinc-900 dark:text-zinc-100 px-6 py-3 rounded-lg font-medium transition-colors">
            <span>👋</span> 了解更多
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">
          最新文章
        </h2>
        <span class="text-sm text-zinc-500 dark:text-zinc-400">
          共 {sortedPosts.length} 篇
        </span>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id.replace(/\.md$/, "")}
            tags={post.data.tags}
          />
        ))}
      </div>

      <!-- 查看更多 -->
      {sortedPosts.length > 6 && (
        <div class="text-center mt-12">
          <details class="inline-block">
            <summary class="cursor-pointer text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 font-medium">
              查看全部文章 ({sortedPosts.length} 篇)
            </summary>
            <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {sortedPosts.slice(6).map((post) => (
                <PostCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={post.id.replace(/\.md$/, "")}
                  tags={post.data.tags}
                />
              ))}
            </div>
          </details>
        </div>
      )}
    </div>
  </section>

  <!-- 统计信息 -->
  <section class="bg-zinc-100 dark:bg-zinc-800/50 py-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-indigo-600 dark:text-indigo-400">
            {sortedPosts.length}
          </div>
          <div class="text-sm text-zinc-500 dark:text-zinc-400">篇文章</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-purple-600 dark:text-purple-400">
            {new Set(sortedPosts.flatMap(p => p.data.tags)).size}
          </div>
          <div class="text-sm text-zinc-500 dark:text-zinc-400">个标签</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-amber-500">
            2026
          </div>
          <div class="text-sm text-zinc-500 dark:text-zinc-400">创建年份</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>