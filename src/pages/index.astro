---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";
import { site } from "../site.config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 6);
---

<BaseLayout title={site.title} description={site.description}>
  <section class="hero">
    <div class="hero-content">
      <h1>{site.title}</h1>
      <p>{site.description}</p>
      <div class="hero-buttons">
        <a href="/search" class="btn-primary">🔍 搜索文章</a>
        <a href="/about" class="btn-secondary">👋 了解更多</a>
      </div>
    </div>
  </section>

  <section class="posts-section">
    <div class="section-header">
      <h2>最新文章</h2>
      <span>共 {sortedPosts.length} 篇</span>
    </div>
    <div class="posts-grid">
      {recentPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id.replace(/\.md$/, "")}
          tags={post.data.tags}
        />
      ))}
    </div>

    {sortedPosts.length > 6 && (
      <details class="more-posts">
        <summary>查看全部文章 ({sortedPosts.length} 篇)</summary>
        <div class="posts-grid more">
          {sortedPosts.slice(6).map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              slug={post.id.replace(/\.md$/, "")}
              tags={post.data.tags}
            />
          ))}
        </div>
      </details>
    )}
  </section>

  <section class="stats">
    <div class="stat">
      <div class="stat-num">{sortedPosts.length}</div>
      <div class="stat-label">篇文章</div>
    </div>
    <div class="stat">
      <div class="stat-num">{new Set(sortedPosts.flatMap(p => p.data.tags)).size}</div>
      <div class="stat-label">个标签</div>
    </div>
    <div class="stat">
      <div class="stat-num">2026</div>
      <div class="stat-label">创建年份</div>
    </div>
  </section>
  <a href="/tools" class="tool-float" title="工具箱">
    <span class="tool-icon">🛠️</span>
  </a>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    padding: 4rem 1rem 6rem;
    text-align: center;
  }
  :global(html.dark) .hero {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }
  .hero-content {
    max-width: 48rem;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1rem;
  }
  :global(html.dark) .hero h1 {
    color: #fafafa;
  }
  .hero p {
    font-size: 1.25rem;
    color: #71717a;
    margin-bottom: 2rem;
  }
  :global(html.dark) .hero p {
    color: #a1a1aa;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .btn-primary {
    background-color: #6366f1;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }
  .btn-primary:hover {
    background-color: #4f46e5;
  }
  .btn-secondary {
    background-color: #e4e4e7;
    color: #18181b;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }
  .btn-secondary:hover {
    background-color: #d4d4d8;
  }
  :global(html.dark) .btn-secondary {
    background-color: #3f3f46;
    color: #fafafa;
  }
  :global(html.dark) .btn-secondary:hover {
    background-color: #52525b;
  }
  .posts-section {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #18181b;
  }
  :global(html.dark) .section-header h2 {
    color: #fafafa;
  }
  .section-header span {
    color: #71717a;
    font-size: 0.875rem;
  }
  :global(html.dark) .section-header span {
    color: #a1a1aa;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more-posts {
    text-align: center;
    margin-top: 3rem;
  }
  .more-posts summary {
    color: #6366f1;
    cursor: pointer;
    font-weight: 500;
  }
  :global(html.dark) .more-posts summary {
    color: #818cf8;
  }
  .more-posts .more {
    margin-top: 1.5rem;
  }
  .stats {
    background-color: #f4f4f5;
    padding: 2rem 1rem;
    text-align: center;
  }
  :global(html.dark) .stats {
    background-color: #27272a;
  }
  .stat {
    display: inline-block;
    margin: 0 2rem;
  }
  .stat-num {
    font-size: 2rem;
    font-weight: 700;
    color: #6366f1;
  }
  :global(html.dark) .stat-num {
    color: #818cf8;
  }
  .stat:nth-child(2) .stat-num {
    color: #8b5cf6;
  }
  :global(html.dark) .stat:nth-child(2) .stat-num {
    color: #a78bfa;
  }
  .stat:nth-child(3) .stat-num {
    color: #f59e0b;
  }
  .stat-label {
    color: #71717a;
    font-size: 0.875rem;
  }
  :global(html.dark) .stat-label {
    color: #a1a1aa;
  }

  /* 悬浮工具箱按钮 */
  .tool-float {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 100;
    width: 3rem;
    height: 3rem;
    background: #6366f1;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
    font-size: 1.25rem;
    text-decoration: none;
  }
  .tool-float:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.6);
    background: #4f46e5;
  }
  :global(html.dark) .tool-float {
    background: #818cf8;
    box-shadow: 0 4px 12px rgba(129, 140, 248, 0.4);
  }
  :global(html.dark) .tool-float:hover {
    background: #6366f1;
  }
  .tool-icon {
    display: inline-block;
    line-height: 1;
  }
</style>