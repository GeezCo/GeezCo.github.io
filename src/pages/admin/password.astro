---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="密码管理" description="简历密码管理">
  <section class="admin-page">
    <article class="admin-card">
      <h1>密码管理</h1>

      <!-- 认证区域 -->
      <div id="auth-area">
        <p class="hint">请输入管理员 Token</p>
        <div class="input-row">
          <input
            type="password"
            id="admin-token"
            placeholder="管理员 Token"
            class="input-field"
          />
          <button id="auth-submit" class="btn btn-primary">验证</button>
        </div>
        <p id="auth-error" class="error-msg hidden">Token 错误</p>
      </div>

      <!-- 管理区域 -->
      <div id="admin-area" class="hidden">
        <!-- 密码管理 -->
        <div class="section">
          <h3>📱 当前临时密码</h3>
          <div id="password-display">
            <p id="no-password" class="hint">暂无临时密码</p>
            <div id="password-info" class="hidden">
              <p class="password-text" id="password-value">--- ---</p>
              <p class="expire-text">有效期至: <span id="expire-time">--:--</span></p>
              <div class="button-row">
                <button id="copy-password" class="btn btn-secondary">📋 复制</button>
              </div>
            </div>
          </div>
          <button id="generate-password" class="btn btn-primary">生成新密码</button>
          <p class="hint">固定密码: <code>password.</code> (备用)</p>
        </div>

        <!-- 锁定管理 -->
        <div class="section">
          <h3>🔒 锁定管理</h3>
          <div id="lockout-list">
            <p id="no-lockouts" class="hint">当前无锁定设备</p>
            <div id="lockouts-container" class="hidden"></div>
          </div>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>

<script>
  const authArea = document.getElementById('auth-area')!;
  const adminArea = document.getElementById('admin-area')!;
  const tokenInput = document.getElementById('admin-token') as HTMLInputElement;
  const authSubmit = document.getElementById('auth-submit')!;
  const authError = document.getElementById('auth-error')!;

  const noPassword = document.getElementById('no-password')!;
  const passwordInfo = document.getElementById('password-info')!;
  const passwordValue = document.getElementById('password-value')!;
  const expireTime = document.getElementById('expire-time')!;
  const copyPasswordBtn = document.getElementById('copy-password')!;
  const generatePasswordBtn = document.getElementById('generate-password')!;

  const noLockouts = document.getElementById('no-lockouts')!;
  const lockoutsContainer = document.getElementById('lockouts-container')!;

  const TOKEN_KEY = 'admin_token';
  const API_BASE = 'https://resume-verify-dezmismfzd.cn-hangzhou.fcapp.run';

  let adminToken = '';
  let refreshInterval: number | null = null;

  // 认证
  authSubmit.addEventListener('click', async () => {
    const token = tokenInput.value.trim();
    if (!token) return;

    try {
      const res = await fetch(`${API_BASE}?action=get-password&token=${encodeURIComponent(token)}`);
      if (!res.ok) {
        authError.classList.remove('hidden');
        return;
      }

      adminToken = token;
      sessionStorage.setItem(TOKEN_KEY, token);
      authArea.classList.add('hidden');
      adminArea.classList.remove('hidden');
      authError.classList.add('hidden');

      await loadPasswordInfo();
      await loadLockouts();
      startRefresh();
    } catch {
      authError.classList.remove('hidden');
    }
  });

  tokenInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') authSubmit.click();
  });

  // 生成新密码
  generatePasswordBtn.addEventListener('click', async () => {
    try {
      const res = await fetch(`${API_BASE}?token=${encodeURIComponent(adminToken)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'generate-password' }),
      });

      if (!res.ok) throw new Error('Failed');

      await loadPasswordInfo();
    } catch {
      alert('生成失败，请重试');
    }
  });

  // 复制密码
  copyPasswordBtn.addEventListener('click', () => {
    const text = passwordValue.textContent?.replace(/\s/g, '') || '';
    navigator.clipboard.writeText(text).then(() => {
      const original = copyPasswordBtn.textContent;
      copyPasswordBtn.textContent = '✅ 已复制';
      setTimeout(() => {
        copyPasswordBtn.textContent = original;
      }, 2000);
    });
  });

  // 加载密码信息
  async function loadPasswordInfo() {
    try {
      const res = await fetch(`${API_BASE}?action=get-password&token=${encodeURIComponent(adminToken)}`);
      if (!res.ok) return;

      const data = await res.json();
      if (data.tempPassword) {
        const { password, expiresAt } = data.tempPassword;
        const formatted = password.slice(0, 3) + ' ' + password.slice(3);
        passwordValue.textContent = formatted;

        const expireDate = new Date(expiresAt);
        expireTime.textContent = expireDate.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });

        noPassword.classList.add('hidden');
        passwordInfo.classList.remove('hidden');
      } else {
        noPassword.classList.remove('hidden');
        passwordInfo.classList.add('hidden');
      }
    } catch {
      console.error('Failed to load password');
    }
  }

  // 加载锁定列表
  async function loadLockouts() {
    try {
      const res = await fetch(`${API_BASE}?action=list-locks&token=${encodeURIComponent(adminToken)}`);
      if (!res.ok) return;

      const data = await res.json();
      const { ips, fingerprints } = data;

      if (ips.length === 0 && fingerprints.length === 0) {
        noLockouts.classList.remove('hidden');
        lockoutsContainer.classList.add('hidden');
        return;
      }

      noLockouts.classList.add('hidden');
      lockoutsContainer.classList.remove('hidden');
      lockoutsContainer.innerHTML = '';

      ips.forEach((item: { ip: string; unlockTime: number }) => {
        const div = document.createElement('div');
        div.className = 'lockout-item';
        const unlockDate = new Date(item.unlockTime);
        div.innerHTML = `
          <div class="lockout-info">
            <strong>🌐 IP:</strong> ${item.ip}<br>
            <span class="unlock-time">解锁时间: ${unlockDate.toLocaleString('zh-CN')}</span>
          </div>
          <button class="btn btn-small" data-type="ip" data-value="${item.ip}">立即解锁</button>
        `;
        lockoutsContainer.appendChild(div);
      });

      fingerprints.forEach((item: { fingerprint: string; unlockTime: number }) => {
        const div = document.createElement('div');
        div.className = 'lockout-item';
        const unlockDate = new Date(item.unlockTime);
        const shortFp = item.fingerprint.slice(0, 20) + '...';
        div.innerHTML = `
          <div class="lockout-info">
            <strong>📱 设备:</strong> ${shortFp}<br>
            <span class="unlock-time">解锁时间: ${unlockDate.toLocaleString('zh-CN')}</span>
          </div>
          <button class="btn btn-small" data-type="fingerprint" data-value="${item.fingerprint}">立即解锁</button>
        `;
        lockoutsContainer.appendChild(div);
      });

      // 绑定解锁按钮
      lockoutsContainer.querySelectorAll('.btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const target = e.target as HTMLButtonElement;
          const type = target.dataset.type;
          const value = target.dataset.value;

          try {
            const body: any = { action: 'unlock' };
            if (type === 'ip') body.ip = value;
            else body.fingerprint = value;

            const res = await fetch(`${API_BASE}?token=${encodeURIComponent(adminToken)}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });

            if (!res.ok) throw new Error('Failed');

            await loadLockouts();
          } catch {
            alert('解锁失败，请重试');
          }
        });
      });
    } catch {
      console.error('Failed to load lockouts');
    }
  }

  // 定时刷新（每 10 秒）
  function startRefresh() {
    if (refreshInterval) clearInterval(refreshInterval);
    refreshInterval = window.setInterval(() => {
      loadPasswordInfo();
      loadLockouts();
    }, 10000);
  }

  // 页面加载时尝试自动登录
  (async () => {
    const savedToken = sessionStorage.getItem(TOKEN_KEY);
    if (savedToken) {
      try {
        const res = await fetch(`${API_BASE}?action=get-password&token=${encodeURIComponent(savedToken)}`);
        if (res.ok) {
          adminToken = savedToken;
          authArea.classList.add('hidden');
          adminArea.classList.remove('hidden');
          await loadPasswordInfo();
          await loadLockouts();
          startRefresh();
        }
      } catch {
        // 自动登录失败，显示认证界面
      }
    }
  })();
</script>

<style>
  .admin-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    padding: 4rem 1rem;
    min-height: 100vh;
  }
  :global(html.dark) .admin-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }
  .admin-card {
    max-width: 56rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .admin-card {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .admin-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .admin-card h1 {
    color: #fafafa;
  }
  .hint {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }
  :global(html.dark) .hint {
    color: #a1a1aa;
  }
  .input-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .input-field {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    background-color: #ffffff;
    color: #18181b;
    outline: none;
    transition: border-color 0.2s;
  }
  .input-field:focus {
    border-color: #6366f1;
  }
  :global(html.dark) .input-field {
    background-color: #3f3f46;
    color: #fafafa;
    border-color: #52525b;
  }
  :global(html.dark) .input-field:focus {
    border-color: #818cf8;
  }
  .btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .btn-primary {
    background-color: #6366f1;
    color: #ffffff;
  }
  .btn-primary:hover {
    background-color: #4f46e5;
  }
  :global(html.dark) .btn-primary {
    background-color: #818cf8;
  }
  :global(html.dark) .btn-primary:hover {
    background-color: #6366f1;
  }
  .btn-secondary {
    background-color: #10b981;
    color: #ffffff;
  }
  .btn-secondary:hover {
    background-color: #059669;
  }
  :global(html.dark) .btn-secondary {
    background-color: #34d399;
    color: #18181b;
  }
  :global(html.dark) .btn-secondary:hover {
    background-color: #10b981;
  }
  .btn-small {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    background-color: #ef4444;
    color: #ffffff;
  }
  .btn-small:hover {
    background-color: #dc2626;
  }
  .error-msg {
    color: #ef4444;
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }
  .hidden {
    display: none;
  }
  .section {
    background-color: #f4f4f5;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  :global(html.dark) .section {
    background-color: #27272a;
  }
  .section h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #18181b;
    margin-bottom: 1rem;
  }
  :global(html.dark) .section h3 {
    color: #fafafa;
  }
  .password-text {
    font-size: 2rem;
    font-weight: 700;
    color: #6366f1;
    letter-spacing: 0.5rem;
    margin-bottom: 0.5rem;
  }
  :global(html.dark) .password-text {
    color: #818cf8;
  }
  .expire-text {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  :global(html.dark) .expire-text {
    color: #a1a1aa;
  }
  .button-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  code {
    background-color: #e4e4e7;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: monospace;
    color: #18181b;
  }
  :global(html.dark) code {
    background-color: #3f3f46;
    color: #fafafa;
  }
  .lockout-item {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  :global(html.dark) .lockout-item {
    background-color: #3f3f46;
    border-color: #52525b;
  }
  .lockout-info {
    flex: 1;
    color: #3f3f46;
    font-size: 0.875rem;
  }
  :global(html.dark) .lockout-info {
    color: #d4d4d8;
  }
  .unlock-time {
    color: #71717a;
    font-size: 0.75rem;
  }
  :global(html.dark) .unlock-time {
    color: #a1a1aa;
  }

  @media (max-width: 480px) {
    .admin-card {
      padding: 1.25rem;
    }
    .input-row {
      flex-direction: column;
    }
    .lockout-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .btn-small {
      width: 100%;
    }
  }
</style>
