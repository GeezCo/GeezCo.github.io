---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="站内搜索">
  <section class="search-page">
    <div class="search-container">
      <h1>🔍 搜索文章</h1>
      <div id="search"></div>
    </div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  new PagefindUI({
    element: "#search",
    showSubResults: true,
    showImages: false,
  });
</script>

<style>
  .search-page {
    background: linear-gradient(to bottom right, #eef2ff, #ffffff, #f3e8ff);
    padding: 4rem 1rem;
    min-height: 60vh;
  }
  :global(html.dark) .search-page {
    background: linear-gradient(to bottom right, #18181b, #18181b, #27272a);
  }
  .search-container {
    max-width: 56rem;
    margin: 0 auto;
  }
  .search-container h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 2rem;
    text-align: center;
  }
  :global(html.dark) .search-container h1 {
    color: #fafafa;
  }
  #search {
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) #search {
    background-color: rgba(39, 39, 42, 0.7);
  }
</style>