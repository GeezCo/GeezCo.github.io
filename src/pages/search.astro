---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="站内搜索">
  <section class="bg-gradient-to-br from-indigo-50 via-white to-purple-50 dark:from-zinc-900 dark:via-zinc-900 dark:to-zinc-800 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="text-3xl font-bold text-zinc-900 dark:text-zinc-100 mb-8 text-center">
        🔍 搜索文章
      </h1>
      <div id="search" class="bg-white dark:bg-zinc-800/70 rounded-2xl shadow-lg p-6"></div>
    </div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  new PagefindUI({
    element: "#search",
    showSubResults: true,
    showImages: false,
  });
</script>