---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="站内搜索">
  <section class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">搜索文章</h1>
    <div id="search" class="mb-8"></div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" is:inline />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  new PagefindUI({
    element: "#search",
    showSubResults: true,
    showImages: false,
  });
</script>