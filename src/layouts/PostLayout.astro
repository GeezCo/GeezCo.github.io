---
import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";
import SponsorBlock from "../components/SponsorBlock.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  locked?: boolean;
}

const { title, description, pubDate, updatedDate, tags = [], locked = false } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <header class="post-header">
    <article class="post-header-card">
      <h1>{title}{locked && <span class="locked-badge" title="密码保护"> 🔒</span>}</h1>
      <div class="post-meta">
        <span>📅 {formattedDate}</span>
        {updatedDate && (
          <span>✏️ 更新于 {updatedDate.toLocaleDateString("zh-CN")}</span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`}>{tag}</a>
          ))}
        </div>
      )}
    </article>
  </header>

  <section class="post-content">
    <div class="prose">
      <slot />
    </div>
  </section>

  <section class="comments">
    <SponsorBlock />
    <Giscus />
  </section>
</BaseLayout>

<script is:inline>
  // 代码块复制和换行功能
  document.addEventListener('DOMContentLoaded', () => {
    const codeBlocks = document.querySelectorAll('pre > code');

    // 从 localStorage 读取换行偏好，默认关闭
    const wrapEnabled = localStorage.getItem('codeWrap') === 'true';

    codeBlocks.forEach((codeBlock) => {
      const pre = codeBlock.parentElement;
      if (!pre) return;

      // 设置相对定位
      pre.style.position = 'relative';

      // 应用初始换行状态
      if (wrapEnabled) {
        pre.classList.add('code-wrap-enabled');
      }

      // 创建换行按钮
      const wrapBtn = document.createElement('button');
      wrapBtn.setAttribute('data-wrap-btn', '');
      wrapBtn.setAttribute('aria-label', wrapEnabled ? '禁用自动换行' : '启用自动换行');
      if (wrapEnabled) {
        wrapBtn.setAttribute('data-wrap-enabled', '');
      }

      // 创建复制按钮
      const copyBtn = document.createElement('button');
      copyBtn.setAttribute('data-copy-btn', '');
      copyBtn.setAttribute('aria-label', '复制代码');

      // 将按钮添加到 pre 元素
      pre.appendChild(wrapBtn);
      pre.appendChild(copyBtn);

      // 换行按钮点击事件
      wrapBtn.addEventListener('click', () => {
        const isEnabled = wrapBtn.hasAttribute('data-wrap-enabled');

        if (isEnabled) {
          // 禁用换行
          wrapBtn.removeAttribute('data-wrap-enabled');
          wrapBtn.setAttribute('aria-label', '启用自动换行');
          pre.classList.remove('code-wrap-enabled');
          localStorage.setItem('codeWrap', 'false');
        } else {
          // 启用换行
          wrapBtn.setAttribute('data-wrap-enabled', '');
          wrapBtn.setAttribute('aria-label', '禁用自动换行');
          pre.classList.add('code-wrap-enabled');
          localStorage.setItem('codeWrap', 'true');
        }

        // 更新所有代码块的换行状态
        document.querySelectorAll('pre').forEach(p => {
          const btn = p.querySelector('[data-wrap-btn]');
          if (btn) {
            if (isEnabled) {
              p.classList.remove('code-wrap-enabled');
              btn.removeAttribute('data-wrap-enabled');
              btn.setAttribute('aria-label', '启用自动换行');
            } else {
              p.classList.add('code-wrap-enabled');
              btn.setAttribute('data-wrap-enabled', '');
              btn.setAttribute('aria-label', '禁用自动换行');
            }
          }
        });
      });

      // 复制按钮点击事件
      copyBtn.addEventListener('click', async () => {
        const code = codeBlock.textContent || '';
        try {
          await navigator.clipboard.writeText(code);
          copyBtn.setAttribute('data-copied', '');
          copyBtn.setAttribute('aria-label', '已复制');
          setTimeout(() => {
            copyBtn.removeAttribute('data-copied');
            copyBtn.setAttribute('aria-label', '复制代码');
          }, 2000);
        } catch (err) {
          console.error('复制失败:', err);
        }
      });
    });
  });
</script>

<style>
  .post-header {
    background: linear-gradient(to bottom right, #eef2ff, #f3e8ff);
    padding: 3rem 1rem;
  }
  :global(html.dark) .post-header {
    background: linear-gradient(to bottom right, #27272a, #18181b);
  }
  .post-header-card {
    max-width: 56rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .post-header-card {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .post-header-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  :global(html.dark) .post-header-card h1 {
    color: #fafafa;
  }
  .post-meta {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 1rem;
  }
  :global(html.dark) .post-meta {
    color: #a1a1aa;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-tags a {
    background-color: #eef2ff;
    color: #4f46e5;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }
  .post-tags a:hover {
    background-color: #e0e7ff;
  }
  :global(html.dark) .post-tags a {
    background-color: rgba(99, 102, 241, 0.2);
    color: #60a5fa;
  }
  :global(html.dark) .post-tags a:hover {
    background-color: rgba(99, 102, 241, 0.3);
  }
  .post-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .comments {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1rem;
  }
</style>