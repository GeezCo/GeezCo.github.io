---
import BaseLayout from "./BaseLayout.astro";
import Giscus from "../components/Giscus.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const formattedDate = pubDate.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <header class="post-header">
    <article class="post-header-card">
      <h1>{title}</h1>
      <div class="post-meta">
        <span>📅 {formattedDate}</span>
        {updatedDate && (
          <span>✏️ 更新于 {updatedDate.toLocaleDateString("zh-CN")}</span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => (
            <a href={`/tags/${tag}`}>{tag}</a>
          ))}
        </div>
      )}
    </article>
  </header>

  <section class="post-content">
    <div class="prose">
      <slot />
    </div>
  </section>

  <section class="comments">
    <Giscus />
  </section>
</BaseLayout>

<style>
  .post-header {
    background: linear-gradient(to bottom right, #eef2ff, #f3e8ff);
    padding: 3rem 1rem;
  }
  :global(html.dark) .post-header {
    background: linear-gradient(to bottom right, #27272a, #18181b);
  }
  .post-header-card {
    max-width: 56rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }
  :global(html.dark) .post-header-card {
    background-color: rgba(39, 39, 42, 0.7);
  }
  .post-header-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: #18181b;
    margin-bottom: 1rem;
    line-height: 1.3;
  }
  :global(html.dark) .post-header-card h1 {
    color: #fafafa;
  }
  .post-meta {
    color: #71717a;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 1rem;
  }
  :global(html.dark) .post-meta {
    color: #a1a1aa;
  }
  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-tags a {
    background-color: #eef2ff;
    color: #4f46e5;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }
  .post-tags a:hover {
    background-color: #e0e7ff;
  }
  :global(html.dark) .post-tags a {
    background-color: rgba(99, 102, 241, 0.2);
    color: #818cf8;
  }
  :global(html.dark) .post-tags a:hover {
    background-color: rgba(99, 102, 241, 0.3);
  }
  .post-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .comments {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1rem;
  }
</style>