---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import SearchModal from "../components/SearchModal.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!DOCTYPE html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={site.url + Astro.url.pathname} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <Analytics />
    <!-- Noto Sans SC 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
    <!-- 初始化主题：避免闪烁 -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <!-- 初始化字体大小：避免闪烁 -->
    <script is:inline>
      (function() {
        const savedSize = localStorage.getItem('fontSize') || 'medium';
        document.documentElement.classList.add('font-' + savedSize);
      })();
    </script>
    <style is:inline>
      /* 基础样式 */
      html { background-color: #fafafa; }
      html.dark { background-color: #18181b; }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      /* 深色模式 */
      html.dark body {
        background-color: #18181b;
        color: #fafafa;
      }
    </style>
  </head>
  <body class="antialiased">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>